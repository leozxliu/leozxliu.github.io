---
layout: default
---
{%- comment -%}
  Local override of al_folio_core's about layout.
  Adds a two-column hero, a blood-flow band, and list-style news.
{%- endcomment -%}
<div class="post home">
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">{{ page.hero.eyebrow }}</p>
      <h1 class="hero-name">{{ site.first_name }} {{ site.last_name }}</h1>
      <p class="hero-role">{{ page.subtitle }}</p>
      <p class="hero-thesis">{{ page.hero.thesis }}</p>
      <div class="hero-actions">
        {% for a in page.hero.actions %}
          <a class="btn-hero{% if forloop.first %} is-primary{% endif %}" href="{{ a.url | relative_url }}">{{ a.label }}</a>
        {% endfor %}
      </div>
    </div>
    <figure class="hero-portrait">
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      {% include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="(min-width: 768px) 300px, 90vw" alt=page.profile.alt cache_bust=true %}
      <figcaption>{{ page.profile.more_info }}</figcaption>
    </figure>
  </section>

  <figure class="flow-band">
    <div class="flow-frame">
      <img src="{{ '/assets/img/banners/home.jpg' | relative_url }}" alt="{{ page.hero.band_alt }}" loading="eager">
    </div>
    <figcaption>{{ page.hero.band_caption }}</figcaption>
  </figure>

  <article>
    <div class="home-body clearfix">{{ content }}</div>

    {% if page.announcements and page.announcements.enabled %}
      {% assign news_size = site.news | size %}
      <section class="home-section">
        <div class="section-head">
          <h2>News</h2>
          <a class="section-link" href="{{ '/news/' | relative_url }}">All {{ news_size }} items →</a>
        </div>
        <ol class="news-list{% if page.announcements.scrollable %} is-scrollable{% endif %}">
          {% assign news = site.news | reverse %}
          {% if page.announcements.limit %}{% assign news_limit = page.announcements.limit %}{% else %}{% assign news_limit = news_size %}{% endif %}
          {% for item in news limit: news_limit %}
            <li>
              <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
              <div class="news-body">
                {% if item.inline %}{{ item.content | emojify }}{% else %}<a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>{% endif %}
              </div>
            </li>
          {% endfor %}
        </ol>
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section class="home-section">
        <div class="section-head">
          <h2>Selected publications</h2>
          <a class="section-link" href="{{ '/publications/' | relative_url }}">Full list →</a>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>

