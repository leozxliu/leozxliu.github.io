---
layout: default
---
{%- comment -%}
  Local override of al_folio_core's about layout.
  Adds a two-column hero, a blood-flow band, and list-style news.
{%- endcomment -%}
<div class="post home">
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">{{ page.hero.eyebrow }}</p>
      <h1 class="hero-name">{{ site.first_name }} {{ site.last_name }}</h1>
      <p class="hero-role">{{ page.subtitle }}</p>
      <p class="hero-thesis">{{ page.hero.thesis }}</p>
      <div class="hero-actions">
        {% for a in page.hero.actions %}
          <a class="btn-hero{% if forloop.first %} is-primary{% endif %}" href="{{ a.url | relative_url }}">{{ a.label }}</a>
        {% endfor %}
      </div>
    </div>
    <figure class="hero-portrait">
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      {% include figure.liquid loading="eager" path=profile_image_path class="img-fluid" sizes="(min-width: 768px) 300px, 90vw" alt=page.profile.alt cache_bust=true %}
      <figcaption>{{ page.profile.more_info }}</figcaption>
    </figure>
  </section>

  <figure class="flow-band" aria-label="Animation of red blood cells in a blood vessel">
    <canvas id="flow-canvas"></canvas>
    <figcaption>
      <span>{{ page.hero.band_caption }}</span>
      <span class="flow-eq">u(r) = u<sub>max</sub>(1 − r²/R²)</span>
    </figcaption>
  </figure>

  <article>
    <div class="home-body clearfix">{{ content }}</div>

    {% if page.announcements and page.announcements.enabled %}
      {% assign news_size = site.news | size %}
      <section class="home-section">
        <div class="section-head">
          <h2>News</h2>
          <a class="section-link" href="{{ '/news/' | relative_url }}">All {{ news_size }} items →</a>
        </div>
        <ol class="news-list{% if page.announcements.scrollable %} is-scrollable{% endif %}">
          {% assign news = site.news | reverse %}
          {% if page.announcements.limit %}{% assign news_limit = page.announcements.limit %}{% else %}{% assign news_limit = news_size %}{% endif %}
          {% for item in news limit: news_limit %}
            <li>
              <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
              <div class="news-body">
                {% if item.inline %}{{ item.content | emojify }}{% else %}<a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>{% endif %}
              </div>
            </li>
          {% endfor %}
        </ol>
      </section>
    {% endif %}

    {% if page.selected_papers %}
      <section class="home-section">
        <div class="section-head">
          <h2>Selected publications</h2>
          <a class="section-link" href="{{ '/publications/' | relative_url }}">Full list →</a>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>

<script>
  (() => {
    const canvas = document.getElementById('flow-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let W = 0, H = 0, cells = [], dpr = 1;

    const css = (name) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas.clientWidth; H = canvas.clientHeight;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(W * H / 1500);
      cells = Array.from({ length: n }, () => spawn(Math.random() * W));
    }
    // Poiseuille flow: speed peaks on the centerline and falls to zero at the wall.
    function spawn(x) {
      const r = (Math.random() * 2 - 1) * 0.92;          // radial position, -1..1
      return { x, r, size: 5 + Math.random() * 3.5, tilt: Math.random() * Math.PI, spin: (Math.random() - 0.5) * 0.02 };
    }
    function drawCell(c, y, fill, rim) {
      ctx.save();
      ctx.translate(c.x, y);
      ctx.rotate(c.tilt);
      ctx.scale(1, 0.62);
      ctx.beginPath(); ctx.arc(0, 0, c.size, 0, Math.PI * 2);
      ctx.fillStyle = rim; ctx.fill();
      ctx.beginPath(); ctx.arc(0, 0, c.size * 0.55, 0, Math.PI * 2);   // biconcave center
      ctx.fillStyle = fill; ctx.fill();
      ctx.restore();
    }
    function frame() {
      const bg = css('--flow-bg'), wall = css('--flow-wall'), rim = css('--flow-cell'), core = css('--flow-core');
      ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = wall; ctx.fillRect(0, 0, W, 3); ctx.fillRect(0, H - 3, W, 3);
      const mid = H / 2, R = H / 2 - 10, umax = 1.1;
      for (const c of cells) {
        if (!reduce) {
          c.x += umax * (1 - c.r * c.r) + 0.08;
          c.tilt += c.spin + c.r * 0.01;                     // shear makes off-center cells tumble
          if (c.x - c.size > W) Object.assign(c, spawn(-c.size));
        }
        drawCell(c, mid + c.r * R, core, rim);
      }
      if (!reduce) requestAnimationFrame(frame);
    }
    resize(); frame();
    let t; window.addEventListener('resize', () => { clearTimeout(t); t = setTimeout(() => { resize(); if (reduce) frame(); }, 150); });
    if (reduce) new MutationObserver(frame).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  })();
</script>
